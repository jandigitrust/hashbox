;;; Cloud-neutral first-boot provisioning for HashBox.
(define-module (hashbox provisioning cloud-init)
  #:use-module (gnu packages bash)
  #:use-module (gnu packages python-web)
  #:use-module (gnu services)
  #:use-module (gnu services shepherd)
  #:use-module (guix gexp)
  #:use-module (guix packages)
  #:use-module (guix records)
  #:use-module (guix utils)
  #:use-module (srfi srfi-13)
  #:use-module (srfi srfi-26)
  #:export (hashbox-cloud-init-configuration
            hashbox-cloud-init-service-type))

;; cloud-init 24.2's Azure datasource records the absence of systemd boot
;; telemetry as a recoverable error.  Shepherd systems do not have those
;; timestamps by design, so make the collector a no-op on non-systemd hosts.
(define hashbox-python-cloud-init
  (package
    (inherit python-cloud-init)
    (name "hashbox-python-cloud-init")
    (arguments
     (substitute-keyword-arguments (package-arguments python-cloud-init)
       ((#:phases phases)
        #~(modify-phases #$phases
            (add-after 'unpack 'support-shepherd-on-azure
              (lambda _
                (substitute* "cloudinit/sources/helpers/azure.py"
                  (("        raise RuntimeError\\(\\\"distro not using systemd, skipping boot telemetry\\\"\\)")
                   "        return None"))))))))))

(define-record-type* <hashbox-cloud-init-configuration>
  hashbox-cloud-init-configuration make-hashbox-cloud-init-configuration
  hashbox-cloud-init-configuration?
  (datasources hashbox-cloud-init-configuration-datasources
               (default '("NoCloud" "ConfigDrive" "Ec2" "Azure"
                          "GCE" "OpenStack" "None")))
  (default-user hashbox-cloud-init-configuration-default-user
                (default "hashbox")))

(define (yaml-inline-list values)
  (string-append "[ " (string-join values ", ") " ]"))

(define (cloud-init-config-file config)
  (let ((datasources
         (yaml-inline-list
          (hashbox-cloud-init-configuration-datasources config)))
        (default-user
         (hashbox-cloud-init-configuration-default-user config)))
    (mixed-text-file
     "hashbox-cloud.cfg"
     "# Generated by the HashBox Guix declaration.\n"
     "# Credentials are supplied by instance metadata, never by the image.\n"
     "users:\n"
     "  - default\n"
     "disable_root: true\n"
     "allow_public_ssh_keys: true\n"
     "ssh_deletekeys: true\n"
     "ssh_genkeytypes: [ed25519]\n"
     "preserve_hostname: true\n"
     "network:\n"
     "  config: disabled\n"
     "datasource_list: " datasources "\n"
     "cloud_init_modules:\n"
     "  - seed_random\n"
     "  - bootcmd\n"
     "  - write_files\n"
     "  - users_groups\n"
     "  - ssh\n"
     "cloud_config_modules:\n"
     "  - runcmd\n"
     "cloud_final_modules:\n"
     "  - scripts_per_once\n"
     "  - scripts_per_boot\n"
     "  - scripts_per_instance\n"
     "  - scripts_user\n"
     "  - ssh_authkey_fingerprints\n"
     "  - final_message\n"
     "system_info:\n"
     "  distro: arch\n"
     "  default_user:\n"
     "    name: " default-user "\n"
     "    lock_passwd: true\n"
     "    shell: " (file-append bash "/bin/bash") "\n"
     "  paths:\n"
     "    cloud_dir: /var/lib/cloud/\n"
     "    templates_dir: /etc/cloud/templates/\n")))

(define (cloud-init-etc-files config)
  `(("cloud/cloud.cfg" ,(cloud-init-config-file config))
    ("cloud/cloud.cfg.d/05_logging.cfg"
     ,(file-append hashbox-python-cloud-init
                   "/etc/cloud/cloud.cfg.d/05_logging.cfg"))))

(define (cloud-init-activation config)
  #~(begin
      (use-modules (guix build utils))
      (for-each mkdir-p
                '("/var/lib/cloud"
                  "/var/log"
                  "/run/cloud-init"))))

(define (cloud-init-command name arguments)
  (program-file
   name
   #~(begin
       (setenv "PATH"
               "/run/current-system/profile/bin:/run/current-system/profile/sbin")
       (unless
           (zero? (system* #$(file-append hashbox-python-cloud-init "/bin/cloud-init")
                           #$@arguments))
         (exit 1)))))

(define (cloud-init-shepherd-services config)
  (define (phase-service name provision requirement arguments)
    (shepherd-service
     (documentation (string-append "Run cloud-init phase " name "."))
     (provision (list provision))
     (requirement requirement)
     (one-shot? #t)
     (start
      #~(lambda _
          (zero? (system* #$(cloud-init-command
                             (string-append "cloud-init-" name)
                             arguments)))))))

  (list
   (phase-service "local" 'cloud-init-local
                  '(file-systems)
                  '("init" "--local"))
   (phase-service "network" 'cloud-init-network
                  '(cloud-init-local networking)
                  '("init"))
   (phase-service "config" 'cloud-init-config
                  '(cloud-init-network)
                  '("modules" "--mode=config"))
   (phase-service "final" 'cloud-init-final
                  '(cloud-init-config)
                  '("modules" "--mode=final"))))

(define hashbox-cloud-init-service-type
  (service-type
   (name 'hashbox-cloud-init)
   (description
    "Provision HashBox from standard cloud-init metadata without embedding credentials.")
   (extensions
    (list (service-extension etc-service-type cloud-init-etc-files)
          (service-extension activation-service-type cloud-init-activation)
          (service-extension profile-service-type
                             (const (list hashbox-python-cloud-init)))
          (service-extension shepherd-root-service-type
                             cloud-init-shepherd-services)))
   (default-value (hashbox-cloud-init-configuration))))
